module turbine_model_expanded

! This module contains two main subroutines - wind_farm_initialize and
! wind_farm_operation. Most wind turbine variables are declared in
! sim_param.f90

use types
use sim_param
use param

contains

subroutine wind_farm_initialize

! This subroutine is called in main.f90 before beginning of the time loop to
! setup the wind farm and various other variables. In case the simulation is
! starting at jt_total greater than zero, it loads the final turbine turbine
! direction and incoming velocity of the previous simulation


integer :: i,j,counter
real(rprec) :: temp_coordinate_x,temp_coordinate_y
real(rprec),dimension(no_of_rows) :: temp_coordinate_row
real(rprec),dimension(no_of_columns) :: temp_coordinate_column
real(rprec),dimension(:),allocatable :: r_array,t_array
logical :: file_exists
character(len=64) :: fname
integer, allocatable :: seed(:)
integer :: size
integer :: jj
real(8) :: u
integer :: dz_local

dz_local = L_z/(nz_tot-1)
call random_seed(size=size)
allocate(seed(size))

call system_clock(i)
seed(:) = i
call random_seed(put=seed)

call random_number(u)

u=0.0

!!!!!!!!!!!!!!!!!!!!!!!!
WT_inflow_averaging_time = WT_time*0.5_rprec ! (in minutes)
correction_time=INT((WT_time*60.0_rprec)/(ref_dt*z_i))
time_weight = (ref_dt*z_i)/(WT_inflow_averaging_time*60.0_rprec + (ref_dt*z_i))
no_of_turbines = no_of_rows * no_of_columns
!!!!!!!!!!!!!!!!!!!!!!!!

allocate(turbine_location(no_of_turbines,3))
allocate(turbine_normal(no_of_turbines,3))
allocate(turbine_inflow_velocity(no_of_turbines,3))

! Algorithm to create a periodic wind farm
! turbine_location is in units of meters
temp_coordinate_x = (real(nx,rprec)/(real(no_of_rows,rprec)))
temp_coordinate_y = (real(ny,rprec)/(real(no_of_columns,rprec)))

counter=0
do i=1,no_of_rows             ! Declared in param.f90
   do j=1,no_of_columns       ! Declared in param.f90
 
     counter=counter+1
     turbine_location(counter,1) = (1.0_rprec + temp_coordinate_x/2.0_rprec + (i-1)*temp_coordinate_x)*(dx*z_i) + u*dx*z_i 
     turbine_location(counter,2) = (1.0_rprec + temp_coordinate_y/2.0_rprec + (j-1)*temp_coordinate_y)*(dx*z_i) + u*dy*z_i
     turbine_location(counter,3) = turbine_height !((turbine_height - ((dz_local*z_i)/2.0_rprec))/(dz_local*z_i)) + 1.0_rprec

     if (coord .eq. 0) then 
        write(*,*) 'counter,turbine_location:',counter,turbine_location(counter,:)
     endif
     turbine_normal(counter,1) = 1.000_rprec
     turbine_normal(counter,2) = 0.000_rprec
     turbine_normal(counter,3) = 0.000_rprec

   end do
end do
!write(*,*) 'I am here, line 43' 

turbine_radius = 53.0_rprec 
! NOTE : THIS IS HARD-CODED - Based on the fact that spacing required is 7D and
! 5D in the streamwise and cross-stream direction respectively


! The AD (actuator disk) is discretized using a radial cordinate system - 
dr = turbine_radius/(no_of_radial_steps+0.5_rprec) ! no_of_radial_steps declared in param.f90
dtheta = 2.0_rprec*pi/no_of_angular_steps ! no_of_angular_steps declared in param.f90

!write(*,*) 'dr,dtheta',dr,dtheta

allocate(r_array(no_of_radial_steps+1))
allocate(t_array(no_of_angular_steps+1))

do i=1,no_of_radial_steps+1
   r_array(i) = dr/2.0_rprec + (i-1)*dr
enddo

do i=1,no_of_angular_steps+1
   t_array(i) = 0.0_rprec + (i-1)*dtheta
enddo

! variables x,y,z denote points of the radial mesh for each AD
! area denotes the surface area associated to each of the {x,y,z} triplets
! radial_distance is the distance of the {x,y,z} to the center of the disk
! NOTE: center of the AD is currently {0,0,0}
allocate(x((no_of_radial_steps)*(no_of_angular_steps)+1))
allocate(y((no_of_radial_steps)*(no_of_angular_steps)+1))
allocate(z((no_of_radial_steps)*(no_of_angular_steps)+1))
allocate(area((no_of_radial_steps)*(no_of_angular_steps)+1))
allocate(radial_distance((no_of_radial_steps)*(no_of_angular_steps)+1))

allocate(temp_x((no_of_radial_steps)*(no_of_angular_steps)+1))
allocate(temp_y((no_of_radial_steps)*(no_of_angular_steps)+1))
allocate(temp_z((no_of_radial_steps)*(no_of_angular_steps)+1))

allocate(temp_u((no_of_radial_steps)*(no_of_angular_steps)+1))
allocate(temp_v((no_of_radial_steps)*(no_of_angular_steps)+1))

counter=0
do i = 2,no_of_radial_steps+1
   do j=2,no_of_angular_steps+1

    counter=counter+1
    x(counter) = 0.0
    y(counter) = (2.0_rprec/(3.0_rprec*dtheta))*(r_array(i)**3.0_rprec - r_array(i-1)**3.0_rprec)/&
                   (r_array(i)**2.0_rprec - r_array(i-1)**2.0_rprec) &
                 * (sin(t_array(j)) - sin(t_array(j-1)))
    z(counter) = (2.0_rprec/(3.0_rprec*dtheta))*(r_array(i)**3.0_rprec - r_array(i-1)**3.0_rprec)/&
                   (r_array(i)**2.0_rprec - r_array(i-1)**2.0_rprec) &
                 * (cos(t_array(j)) - cos(t_array(j-1)))
    area(counter) = (dtheta/2.0_rprec)*(r_array(i)**2.0_rprec - r_array(i-1)**2.0_rprec)
    radial_distance(counter) = sqrt(y(counter)**2.0_rprec + z(counter)**2.0_rprec)

   enddo
enddo

! the final point in the x,y,z arrays in the disk center
x(counter+1) = 0.0_rprec 
y(counter+1) = 0.0_rprec
z(counter+1) = 0.0_rprec
area(counter+1) = pi*((dr/2.0_rprec)**2.0_rprec)
radial_distance(counter+1) = 0.0_rprec

!if (coord .eq. 0) then
!do i = 1,size(area,1)

!write(*,*) i,x(i),y(i),z(i),area(i),radial_distance(i)

!enddo
!endif

! initializing the time and disk averaged inflow velocity
time_disk_avg_velo(:) = 0.0_rprec

! initializing the upstream scanning distance - similar to old code
    if(PATTERN .EQ. 1) then

       if(mod(coord,4) .EQ. 0) then
          up_dist = turbine_radius*4.0_rprec
       elseif(mod(coord,4) .EQ. 1) then
          up_dist = turbine_radius*1.0_rprec
       elseif(mod(coord,4) .EQ. 2) then
          up_dist = turbine_radius*2.0_rprec
       elseif(mod(coord,4) .EQ. 3) then
          up_dist = turbine_radius*3.0_rprec
       endif

    elseif(PATTERN .EQ. 2) then

       if(mod(coord,4) .EQ. 0) then
          up_dist = turbine_radius*0.0_rprec
       elseif(mod(coord,4) .EQ. 1) then
          up_dist = turbine_radius*4.0_rprec
       elseif(mod(coord,4) .EQ. 2) then
          up_dist = turbine_radius*6.0_rprec
       elseif(mod(coord,4) .EQ. 3) then
          up_dist = turbine_radius*8.0_rprec
       endif

    elseif(PATTERN .EQ. 0) then
       up_dist=0.0_rprec
    endif

! initializing the running average of the orientation of the AD
running_theta = 0.0_rprec

allocate(force_all(6,27*((no_of_radial_steps)*(no_of_angular_steps)+1))) 
allocate(force_global(6,27*no_of_turbines*((no_of_radial_steps)*(no_of_angular_steps)+1)))
allocate(loc_power(27*((no_of_radial_steps)*(no_of_angular_steps)+1)))
allocate(loc_torque(3,27*((no_of_radial_steps)*(no_of_angular_steps)+1)))

  open(UNIT=200,FILE='./total_time.dat',FORM="FORMATTED",ACTION="READ")
      read(200,*) jt_org
  close(200)

! If simulation is being restarted, the running average of the orientation and
! the inflow velocity is reloaded from files in the folder turbine_data
  if(jt_org .gt. 0) then
          write(fname,'("./turbine_data/restart_theta.",i0)') coord+1
          INQUIRE(FILE=fname,EXIST=file_exists)
          if(file_exists) then
             open(UNIT=200,FILE=fname,FORM="FORMATTED",ACTION="READ")
             read(200,*) running_theta
             close(200)
          endif
!          running_theta = running_theta *real(correction_time,rprec)

          write(fname,'("./turbine_data/restart_turb_inflow.",i0)') coord+1
          INQUIRE(FILE=fname,EXIST=file_exists)
          if(file_exists) then
             open(UNIT=200,FILE=fname,FORM="FORMATTED",ACTION="READ")
             read(200,*) velo_for_force_calc
             close(200)
          endif
        time_disk_avg_velo = velo_for_force_calc * (/cos(running_theta/real(correction_time,rprec)), &
                                                     sin(running_theta/real(correction_time,rprec)) /)      
   endif
 

end subroutine wind_farm_initialize

subroutine wind_farm_operation

real(rprec),dimension(3) :: p
real(rprec),dimension(27) :: weight
real(rprec),dimension(3) :: s
real(rprec) :: theta
real(rprec),dimension(3) :: center,center_coord
integer,dimension(3,27) :: les_p
integer :: turb_no,counter_point
real(rprec),dimension(nx,ny,nz-1) :: tmp_u,tmp_v,tmp_w
real(rprec),dimension(nx,ny,nz_tot-1) :: u_regroup,v_regroup,w_regroup
real(rprec) :: f_t,f_theta
real(rprec),dimension(3) :: force_total
integer,dimension(nproc) :: recvcounts,displs
integer :: dest,t_k_local
integer :: counter_force
integer :: t_i,t_j,t_k
character(len=64) :: fname
integer,dimension(3) :: closest_p
real(rprec) :: total_weight
integer :: ii,jj,kk
real(rprec) :: distance
integer :: dz_local

dz_local = L_z/(nz_tot-1)

!force_x(:,:,:) = 0.0_rprec
!force_y(:,:,:) = 0.0_rprec
!force_z(:,:,:) = 0.0_rprec


! GATHERING ENTIRE VELOCITY FIELD
do i = 1,nx
   do j = 1,ny
      do k = 1,nz-1
         tmp_u(i,j,k) = u(i,j,k)
         tmp_v(i,j,k) = v(i,j,k)
         tmp_w(i,j,k) = w(i,j,k)
      end do
   end do
end do

recvcounts = size(tmp_u)
displs = coord_of_rank * recvcounts

call mpi_allgatherv (tmp_u(1,1,1), size(tmp_u), MPI_RPREC,        &
     u_regroup, recvcounts, displs, MPI_RPREC,  &
     comm, ierr)

call mpi_allgatherv (tmp_v(1,1,1), size(tmp_v), MPI_RPREC,        &
     v_regroup, recvcounts, displs, MPI_RPREC,  &
     comm, ierr)

call mpi_allgatherv (tmp_w(1,1,1), size(tmp_w), MPI_RPREC,        &
     w_regroup, recvcounts, displs, MPI_RPREC,  &
     comm, ierr)

if((coord .GE. 0) .AND. (coord .LT. no_of_turbines)) then

   turb_no = coord+1
   
   center = turbine_location(turb_no,:) ! in meters

! center_coord converts the location of the center in meters to the coordinate
! system
   center_coord(1) = center(1)/(dx*z_i) 
   center_coord(2) = center(2)/(dy*z_i)
   center_coord(3) = ((center(3) - ((dz_local*z_i)/2.0_rprec))/(dz_local*z_i)) + 1.0_rprec
! center_coord is in the coordinate system

   theta = atan2(turbine_normal(turb_no,2),turbine_normal(turb_no,1))
  
   !write(*,*) 'In WT algo - jt,coord:',jt,coord 
   if(mod(jt_total,correction_time) .EQ. 0) then

    write(*,*) 'Correcting WT orientation @ jt_total=',turb_no,jt_total
    write(*,*) 'running_theta,velo_for_force_calc',running_theta,velo_for_force_calc

          write(fname,'("./turbine_data/restart_theta.",i0)') coord+1
          open(UNIT=200,FILE=fname,FORM="FORMATTED",ACTION="WRITE",STATUS="REPLACE")
          write(200,*) running_theta
          close(200)

          write(fname,'("./turbine_data/restart_turb_inflow.",i0)') coord+1
          open(UNIT=200,FILE=fname,FORM="FORMATTED",ACTION="WRITE",STATUS="REPLACE")
          write(200,*) velo_for_force_calc
          close(200)
          
     theta = running_theta/real(correction_time,rprec)
  
     turbine_normal(turb_no,2) = sin(theta)
     turbine_normal(turb_no,1) = cos(theta)  

     running_theta = 0.0_rprec

! {x,y,z} is fixed in wind_farm_initialize. Based on the orientation of the AD,
! the x,y,z triplets are rotated about the z axis and stored in
! temp_x,temp_y,temp_z variables     
     do i=1,size(x,1)
       temp_x(i) = x(i)*cos(theta) - y(i)*sin(theta)
       temp_y(i) = x(i)*sin(theta) + y(i)*cos(theta)
       temp_z(i) = z(i)
     enddo

! After every correction step, the new AD radial mesh points are stored in
! turbine_points data file. They are stored in the units of coordinates.    
!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
       write(fname,'("./turbine_data/turbine_points.",i0)') coord+1
       open(UNIT=200,FILE=fname,FORM="FORMATTED",ACTION="WRITE",POSITION="APPEND")
       do i=1,size(x,1)
           p(1) = (temp_x(i) + center(1))/(dx*z_i)
           p(2) = (temp_y(i) + center(2))/(dy*z_i)
           p(3) = ((temp_z(i)+ center(3) - ((dz_local*z_i)/2.0_rprec))/(dz_local*z_i)) + 1.0_rprec     
         write(200,*) jt_total,p
       enddo
       close(200)
!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!

! The upstream scanning disk points are stored as well     
!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
       write(fname,'("./turbine_data/upwind_points.",i0)') coord+1
       open(UNIT=200,FILE=fname,FORM="FORMATTED",ACTION="WRITE",POSITION="APPEND")
       do i=1,size(x,1)
           p(1) = (temp_x(i) + center(1) - up_dist*turbine_normal(turb_no,1))/(dx*z_i)
           p(2) = (temp_y(i) + center(2) - up_dist*turbine_normal(turb_no,2))/(dy*z_i)
           p(3) = ((temp_z(i)+ center(3) - ((dz_local*z_i)/2.0_rprec))/(dz_local*z_i)) + 1.0_rprec
           write(200,*) jt_total,p
       enddo
       close(200)
!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!

!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
       write(fname,'("./turbine_data/angle_data.",i0)') coord+1
       open(UNIT=200,FILE=fname,FORM="FORMATTED",ACTION="WRITE",POSITION="APPEND")
           write(200,*) jt_total,theta
       close(200)
!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!

     
   endif ! end of correction if statement


!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
!! MAIN OPERATIONAL PART OF THE WIND TURBINE ALGORITM


counter_force = 0

!! LOOP 1: upstream scanning disk
!! OBJECTIVE: compute the orientation of the time and disk averaged velocity at
!the upstream disk
     do i=1,size(x,1)

       p(1) = (temp_x(i) + center(1) - up_dist*turbine_normal(turb_no,1))/(dx*z_i)
       p(2) = (temp_y(i) + center(2) - up_dist*turbine_normal(turb_no,2))/(dy*z_i)
       p(3) = ((temp_z(i)+ center(3) - ((dz_local*z_i)/2.0_rprec))/(dz_local*z_i)) + 1.0_rprec

       closest_p  = (/nint(p(1)),nint(p(2)),nint(p(3))/)
       counter_point=0
       les_p = 0
       weight= 0
       total_weight=0.0_rprec
       do ii=-1,1
          do jj=-1,1
             do kk=-1,1
              counter_point=counter_point+1
              les_p(:,counter_point) = (/closest_p(1)+ii,closest_p(2)+jj,closest_p(3)+kk/)
              !weight(counter_point) = 1.0_rprec / sqrt(dot_product(real(les_p(:,counter_point),rprec) - p, &
              !                                                     real(les_p(:,counter_point),rprec) - p ))
              distance = sqrt(((les_p(1,counter_point)-p(1))*(dx*z_i))**2.0_rprec + &
                              ((les_p(2,counter_point)-p(2))*(dy*z_i))**2.0_rprec + &
                              ((les_p(3,counter_point)-p(3))*(dz_local*z_i))**2.0_rprec)
              weight(counter_point) = 1.0_rprec / distance  ! Inverse distance weighting
              total_weight = total_weight + weight(counter_point)
             enddo
          enddo
       enddo

       temp_u(i) = 0.0_rprec
       temp_v(i) = 0.0_rprec
       do j=1,27
         temp_u(i) = temp_u(i) + (weight(j)/total_weight)*u_regroup(les_p(1,j),les_p(2,j),les_p(3,j)) 
         temp_v(i) = temp_v(i) + (weight(j)/total_weight)*v_regroup(les_p(1,j),les_p(2,j),les_p(3,j)) 
       enddo !end of loop j=1,8
         
     enddo   
         running_theta = running_theta + atan2(sum(temp_v)/real(size(x,1),rprec),sum(temp_u)/real(size(x,1),rprec))

!!! END OF LOOP 1

!!! LOOP 2
!!! OBJECTIVE: compute the time and disk averaged velocity at the AD disk. This
!quantity is used the compute the forces 
     do i=1,size(x,1)

       p(1) = (temp_x(i) + center(1))/(dx*z_i)
       p(2) = (temp_y(i) + center(2))/(dy*z_i)
       p(3) = ((temp_z(i)+ center(3) - ((dz_local*z_i)/2.0_rprec))/(dz_local*z_i)) + 1.0_rprec

       closest_p  = (/nint(p(1)),nint(p(2)),nint(p(3))/)
       counter_point=0
       les_p = 0
       weight= 0
       total_weight=0.0_rprec
       do ii=-1,1
          do jj=-1,1
             do kk=-1,1
              counter_point=counter_point+1
              les_p(:,counter_point) = (/closest_p(1)+ii,closest_p(2)+jj,closest_p(3)+kk/)
              !weight(counter_point) = 1.0_rprec / sqrt(dot_product(real(les_p(:,counter_point),rprec) - p, &
              !                                                     real(les_p(:,counter_point),rprec) - p ))
              distance = sqrt(((les_p(1,counter_point)-p(1))*(dx*z_i))**2.0_rprec + &
                              ((les_p(2,counter_point)-p(2))*(dy*z_i))**2.0_rprec + &
                              ((les_p(3,counter_point)-p(3))*(dz_local*z_i))**2.0_rprec)
              weight(counter_point) = 1.0_rprec / distance
              total_weight = total_weight + weight(counter_point)
             enddo
          enddo
       enddo

       temp_u(i) = 0.0_rprec
       temp_v(i) = 0.0_rprec
       do j=1,27
         temp_u(i) = temp_u(i) + (weight(j)/total_weight)*u_regroup(les_p(1,j),les_p(2,j),les_p(3,j)) 
         temp_v(i) = temp_v(i) + (weight(j)/total_weight)*v_regroup(les_p(1,j),les_p(2,j),les_p(3,j))
       enddo !end of loop j=1,8
         
     enddo  
!!! END OF LOOP 2

         time_disk_avg_velo = (1.0_rprec - time_weight)*time_disk_avg_velo + time_weight*(/sum(temp_u)/real(size(x,1)),&
                                                                                           sum(temp_v)/real(size(x,1))/) 
 
         velo_for_force_calc = DOT_PRODUCT(time_disk_avg_velo,turbine_normal(turb_no,1:2))

         f_t = -0.5_rprec * Ct_prime * (velo_for_force_calc**2.0_rprec)
         
         angular_velocity = local_tip_speed_ratio*velo_for_force_calc/turbine_radius

!! LOOP 3
! creating the variable force_all - each entry consists of 6 - LES point {a,b,c}
! and the 3-d force vector to be applied at LES point {a,b,c}

     do i=1,size(x,1)

       p(1) = (temp_x(i)+center(1))/(dx*z_i)
       p(2) = (temp_y(i)+center(2))/(dy*z_i)
       p(3) = ((temp_z(i)+center(3) - ((dz_local*z_i)/2.0_rprec))/(dz_local*z_i)) + 1.0_rprec

       
       if(.NOT.(rotating_wake)) then
         f_theta=0.0_rprec
       endif

       if(rot_wake_test) then
         f_t = 0.0_rprec
       endif

       ! no tangential force for the center of the disk
       if(radial_distance(i) .EQ. 0) then
          f_theta = 0.0_rprec
          force_total = f_t * turbine_normal(turb_no,:)
       else
       f_theta = 0.5_rprec * &
                 Cp_prime  * &
                 (velo_for_force_calc**2.0_rprec) * &
                 (DOT_PRODUCT( (/sum(temp_u)/real(size(x,1)),&
                                 sum(temp_v)/real(size(x,1))/) ,&
                              turbine_normal(turb_no,1:2) )/(angular_velocity * radial_distance(i)))  


          force_total = f_t * turbine_normal(turb_no,:) + f_theta * cross_product((/temp_x(i),temp_y(i),temp_z(i)/)/radial_distance(i),&
                                                                                turbine_normal(turb_no,:))
       endif

       closest_p  = (/nint(p(1)),nint(p(2)),nint(p(3))/)
       counter_point=0
       les_p = 0
       weight= 0
       total_weight=0.0_rprec
       do ii=-1,1
          do jj=-1,1
             do kk=-1,1
              counter_point=counter_point+1
              les_p(:,counter_point) = (/closest_p(1)+ii,closest_p(2)+jj,closest_p(3)+kk/)
              !weight(counter_point) = 1.0_rprec / sqrt(dot_product(real(les_p(:,counter_point),rprec) - p , & 
              !                                                     real(les_p(:,counter_point),rprec) - p  ))
              distance = sqrt( ((les_p(1,counter_point)-p(1))*(dx*z_i))**2.0_rprec + &
                               ((les_p(2,counter_point)-p(2))*(dy*z_i))**2.0_rprec + &
                               ((les_p(3,counter_point)-p(3))*(dz_local*z_i))**2.0_rprec )

              weight(counter_point) = 1.0_rprec / distance
              total_weight = total_weight + weight(counter_point)
             enddo
          enddo
       enddo

       do j=1,27

       counter_force = counter_force + 1
       force_all(1:3,counter_force) = (/real(les_p(1,j),rprec),real(les_p(2,j),rprec),real(les_p(3,j),rprec)/)
       force_all(4,counter_force) = (weight(j)/total_weight)*area(i)*force_total(1)
       force_all(5,counter_force) = (weight(j)/total_weight)*area(i)*force_total(2)
       force_all(6,counter_force) = (weight(j)/total_weight)*area(i)*force_total(3)
 
       enddo !end of loop j=1,27

   enddo

! compute power and torque
   do i=1,size(force_all,2)

       loc_power(i) = DOT_PRODUCT(force_all(4:6,i),(/u_regroup(int(force_all(1,i)),int(force_all(2,i)),int(force_all(3,i))),&
                                                                 v_regroup(int(force_all(1,i)),int(force_all(2,i)),int(force_all(3,i))),&
                                                                 0.5_rprec*(w_regroup(int(force_all(1,i)),int(force_all(2,i)),int(force_all(3,i))+1) + &
                                                                            w_regroup(int(force_all(1,i)),int(force_all(2,i)),int(force_all(3,i))))  /))
       loc_torque(:,i) = cross_product((force_all(1:3,i)-center_coord),force_all(4:6,i)) 
   enddo

!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
       write(fname,'("./power_torque.",i0)') coord+1
       open(UNIT=200,FILE=fname,FORM="FORMATTED",ACTION="WRITE",POSITION="APPEND")
       write(200,*) 'jt,theta,power,torque,time_and_disk_avg_velo:',jt_total,theta,sum(loc_power),sum(loc_torque,2),velo_for_force_calc
       close(200)
!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
  
!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
       if(jt .eq. nsteps) then
          write(fname,'("./turbine_data/restart_theta.",i0)') coord+1
          open(UNIT=200,FILE=fname,FORM="FORMATTED",ACTION="WRITE",STATUS="REPLACE")
          write(200,*) running_theta
          close(200)

          write(fname,'("./turbine_data/restart_turb_inflow.",i0)') coord+1
          open(UNIT=200,FILE=fname,FORM="FORMATTED",ACTION="WRITE",STATUS="REPLACE")
          write(200,*) velo_for_force_calc
          close(200)

       endif
!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!        

 
else
 force_all(:,:) = 0.0_rprec
endif    

call mpi_barrier(comm,ierr)

!! ALL PROCS ARE NOW ENGAGED

! force_all variable is put together from all the wind_turbine procs and then
! delivered to all procs

recvcounts(:) = 0
recvcounts(1:no_of_turbines) = size(force_all)

displs(:) = 0
do i=1,no_of_turbines
  displs(i) = size(force_all)*(i-1)
enddo

call mpi_allgatherv (force_all, recvcounts(coord+1), MPI_RPREC,   &
                     force_global, recvcounts, displs, MPI_RPREC,  &
                     comm, ierr)

call mpi_barrier(comm,ierr)

! force_global - collection of all force_all variables from all wind turbines
! are outputted every "correction_time" steps
if (coord .eq. 0) then
 if (mod(jt,correction_time) .eq. 0) then
   write(fname,'("./force_global.",i7.7)') jt_total+1
   open(unit=200,FILE=fname,FORM="FORMATTED",action="WRITE",position="append")
   do i=1,size(force_global,2)
     write(200,*) force_global(:,i)
   enddo
   close(200)
 endif
endif

! final loop to apply the force_global forces to the correct LES points in the
! MPI sense
do i=1,size(force_global,2)

  t_i = int(force_global(1,i))
  t_j = int(force_global(2,i))
  t_k = int(force_global(3,i))

  dest = CEILING(force_global(3,i)/REAL(nz-1))-1  

       if (MOD(t_k,(nz-1)) .EQ. 0) then
          t_k_local = nz-1
       else
          t_k_local = MOD(t_k,(nz-1))
       endif
       if(coord==dest) then

        RHSx(t_i,t_j,t_k_local) = RHSx(t_i,t_j,t_k_local) + force_global(4,i)/(dx*dy*dz_local*z_i*z_i) 
        RHSy(t_i,t_j,t_k_local) = RHSy(t_i,t_j,t_k_local) + force_global(5,i)/(dx*dy*dz_local*z_i*z_i) 
        RHSz(t_i,t_j,t_k_local) = RHSz(t_i,t_j,t_k_local) + force_global(6,i)/(dx*dy*dz_local*z_i*z_i) 

       endif

enddo

call mpi_barrier(comm,ierr)

end subroutine wind_farm_operation

function cross_product(a,b)
    real(rprec),intent(in),dimension(3) :: a,b
    real(rprec),dimension(3) :: cross_product
    cross_product(1) = a(2)*b(3) - a(3)*b(2)
    cross_product(2) = (-1.0)*(a(1)*b(3) - a(3)*b(1))
    cross_product(3) = a(1)*b(2) - a(2)*b(1)
end function cross_product

end module turbine_model_expanded
