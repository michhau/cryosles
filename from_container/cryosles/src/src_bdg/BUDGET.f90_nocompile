module budget

use types,only:rp=>rprec
use param,only: nx,ny,nz,ld,dz,re
use sim_param
use sp_sc1
use sgsmodule,only:beta,cs_opt2,nu_t
use deriv,only:ddz_uv

implicit none


logical,parameter :: uwBudget=.false.,          &
                     tkeBudget=.false.,         &      
                     onlyImp=.false.
real,dimension(ld,ny,0:nz),save :: au,av,aw,ap,auu,avv,aww,auv,auw,avw,   &
                                       atxx,atyy,atzz,atxy,atxz,atyz,            &
                                       adudx,adudy,adudz,advdx,advdy,advdz,      &
                                       adwdx,adwdy,adwdz,      &
                                       adpdx,adpdy,adpdz,      &
                                       audpdx,avdpdy,awdpdz,   & ! full pressure term (to check)
                                       apdudx,apdvdy,apdwdz,   & ! return to isotropy
                                       apdudz,apdwdx,          & ! return to isotropy for momentum fluxes
                                       apw,apw_wnode,apu,      & ! transport
                                       autxz,avtyz,awtzz,      & 
                                       auuw,avvw,awww,         &
                                       auww,                   & ! transport for momentum flux
                                       adxx,adyy,adzz,         & ! sgs dissip
                                       adxy,adxz,adyz,         &
                                       adxx2,adyy2,adzz2,      &
                                       aduw,                   & ! dissipation uw
                                       acs,abeta,anut
real,dimension(:,:,:),allocatable,save :: as,aus,ass,avs,aws,atsx,atsy,atsz,   &
                                          adsdx,adsdy,adsdz,apdsdz,apsc1,asww, &
                                          ads,abetas,anus,adsw



!##############################################################################
contains


!##################################################################################



!!------------------------------------------------------------------------------
!!  OBJECT: subroutine ComputeBudget()
!!------------------------------------------------------------------------------
!!
!!  LAST CHECKED/MODIFIED: Marco Giometto ( mgiometto@gmail.com ), day 26/07/2014
!!
!!  DESCRIPTION:
!!
!!  This subroutine extracts the needed statistics for the KAT simulation
!!  all data are interpolated in w nodes
!!
!!
!!  Production is OK
!!  Buoyancy production is also OK
!!  Pressure transport is OK
!!  Transport by molecular diffusion and turbulence is OK
!!  Dissipation is OK
!!  
!!------------------------------------------------------------------------------
subroutine ComputeBudget()

implicit none

integer :: i,j,k

real(rp),dimension(ld,ny,0:nz) :: scr1,scr2,scr3  !scratch useful for interpolation
character(256) :: fname
logical,save :: init=.false.
integer,save :: ii=1

if(s_flag.and.(.not.init)) call allocScVar()

!write parameters to avg_field
if((coord==0).and.(.not.init))then
   print*,'writing parameters for budget'
   write(fname,'(a)') trim(ta1_field)//'parameters.txt'
   open(111,file=trim(fname),status='new')
   write(111,*) nx
   write(111,*) ny
   write(111,*) nz_tot-1
   write(111,*) l_x
   write(111,*) l_y
   write(111,*) l_z
   write(111,*) nsteps/p_cnt3
   write(111,*) nproc
   write(111,*) Re
   write(111,*) alpha
   close(111)

   !switch
   init=.true.

endif

!mean vars on uvp nodes
call avg_var(u,au,'u',ii)                                                            !vel
call avg_var(v,av,'v',ii)
call int_var(w,scr1); call avg_var(scr1,aw,'w',ii)
if(s_flag) call avg_var(sc1,as,'s',ii)                                               !vel

call avg_var(u*u,auu,'uu',ii)                                                        !res flux
call avg_var(v*v,avv,'vv',ii)
call avg_var(scr1*scr1,aww,'ww',ii)
call avg_var(u*v,auv,'uv',ii)
call avg_var(scr1*u,auw,'uw',ii)
call avg_var(scr1*v,avw,'vw',ii)
if(s_flag) call avg_var(sc1*sc1,ass,'ss',ii)    
if(s_flag) call avg_var(u*sc1,aus,'su',ii)    
if(s_flag) call avg_var(v*sc1,avs,'sv',ii)
if(s_flag) call avg_var(scr1*sc1,aws,'sw',ii)

call avg_var(txx,atxx,'txx',ii)                                                      !sgs flux or dns stress
call avg_var(tyy,atyy,'tyy',ii)
call avg_var(tzz,atzz,'tzz',ii)
call avg_var(txy,atxy,'txy',ii)
call int_var(txz,scr1); call avg_var(scr1,atxz,'txz',ii)
call int_var(tyz,scr1); call avg_var(scr1,atyz,'tyz',ii)
if(s_flag) call avg_var(txsc1,atsx,'tsx',ii)
if(s_flag) call avg_var(tysc1,atsy,'tsy',ii)
if(s_flag) call int_var(tzsc1,scr1); call avg_var(scr1,atsz,'tsz',ii)

call avg_var(dudx,adudx,'dudx',ii)                                                   !derivatives
call avg_var(dudy,adudy,'dudy',ii)
call int_var(dudz,scr1); call avg_var(scr1,adudz,'dudz',ii)
call avg_var(dvdx,advdx,'dvdx',ii) 
call avg_var(dvdy,advdy,'dvdy',ii)
call int_var(dvdz,scr1); call avg_var(scr1,advdz,'dvdz',ii)
call int_var(dwdx,scr1); call avg_var(scr1,adwdx,'dwdx',ii) 
call int_var(dwdy,scr1); call avg_var(scr1,adwdy,'dwdy',ii)
call avg_var(dwdz,adwdz,'dwdz',ii)

if(s_flag) call avg_var(dsc1dx,adsdx,'dsdx',ii)
if(s_flag) call avg_var(dsc1dy,adsdy,'dsdy',ii)
if(s_flag) call int_var(dsc1dz,scr1); call avg_var(scr1,adsdz,'dsdz',ii)

call int_var(w,scr1); call avg_var(u**2*scr1,auuw,'uuw',ii)                          !transp res
call avg_var(v**2*scr1,avvw,'vvw',ii)
call avg_var(scr1**3,awww,'www',ii)
call avg_var(scr1**2*u,auww,'uww',ii)
if(s_flag) call avg_var(scr1**2*sc1,asww,'sww',ii)

call avg_var(scr1*tzz,awtzz,'wtzz',ii)                                               !transp sgs
call int_var(txz,scr1); call avg_var(scr1*u,autxz,'utxz',ii)
call int_var(tyz,scr2); call avg_var(scr2*v,avtyz,'vtyz',ii)

call avg_var(dudx*txx,adxx,'dxx',ii)                                                  !diss
call avg_var(dvdy*tyy,adyy,'dyy',ii)
call avg_var(dwdz*tzz,adzz,'dzz',ii)
call avg_var(0.5_rp*(dudy+dvdx)*txy,adxy,'dxy',ii)
call int_var(dudz+dwdx,scr2); call avg_var(0.5_rp*scr2*scr1,adxz,'dxz',ii)
call int_var(dvdz+dwdy,scr2); call int_var(tyz,scr1); call avg_var(0.5*scr2*scr1,adyz,'dyz',ii)

!second dissipation (to check)
call avg_var((dudx**2+dudy**2+dudz**2),adxx2,'dxx2',ii)                         !diss
call avg_var((dvdx**2+dvdy**2+dvdz**2),adyy2,'dyy2',ii)                         !diss
call avg_var((dwdx**2+dwdy**2+dwdz**2),adzz2,'dzz2',ii)                         !diss
!momentum flux dissipation (to check)
call avg_var((dudx*dwdx+dudy*dwdy+dudz*dwdz),aduw,'duw',ii)                     !diss (no interpolation see what happens)

!buoyancy flux dissipation (to check)
if(s_flag) call avg_var((dsc1dx*dwdx+dsc1dy*dwdy+dsc1dz*dwdz),adsw,'dsw',ii)    !diss (no interpolation see what happens)

!pressure stuff (tranport+return to isotropy)
do k=0,nz-1
  scr1(:,:,k)=p(:,:,k)-0.5_rp*(u(:,:,k)**2+v(:,:,k)**2+(0.5_rp*(w(:,:,k)+w(:,:,k+1)))**2) 
enddo
scr1(:,:,nz)=scr1(:,:,nz-1)
call avg_var(scr1,ap,'p',ii)                                                     !cleaned pressure
call int_var(w,scr2); call avg_var(scr1*scr2,apw,'pw',ii)                        !pressure transp tke
call avg_var(scr1*u,apu,'pu',ii)                                                 !pressure transp uw
if(s_flag) call avg_var(scr1*sc1,apsc1,'ps',ii)                                  !pressure transp ps

call avg_var(dudx*scr1,apdudx,'pdudx',ii)                                        !ret. isotropy 1
call avg_var(dvdy*scr1,apdvdy,'pdvdy',ii)                                        !ret. isotropy 2
call avg_var(dwdz*scr1,apdwdz,'pdwdz',ii)                                        !ret. isotropy 3
call int_var(dudz,scr2); call avg_var(scr2*scr1,apdudz,'pdudz',ii)               !ret. isotropy 4
call int_var(dwdx,scr2); call avg_var(scr2*scr1,apdwdx,'pdwdx',ii)               !ret. isotropy 5
if(s_flag) call int_var(dsc1dz,scr2); call avg_var(scr2*scr1,apdsdz,'pdsdz',ii)  !ret. isotropy 6

!full pressure term
call filt_da(scr1,scr2,scr3)
call avg_var(scr2,adpdx,'dpdx',ii)
call avg_var(scr3,adpdy,'dpdy',ii)
call avg_var(u*scr2,audpdx,'udpdx',ii)
call avg_var(v*scr3,avdpdy,'vdpdy',ii)
call ddz_uv(scr2,scr1)
call avg_var(scr2,adpdz,'dpdz',ii)
call int_var(w*scr2,scr1); call avg_var(scr1,awdpdz,'wdpdz',ii)

if(sgs)then
    scr1(:,:,1:nz)=cs_opt2(:,:,:)
    scr1(:,:,0)=BOGUS
    call int_var(scr1,scr2); call avg_var(scr2,acs,'cs',ii)                     !les stuff
    call int_var(BETA,scr1); call avg_var(scr1,abeta,'beta',ii)
    call int_var(NU_T,scr1); call avg_var(scr1,anut,'nu_t',ii)

    scr1(:,:,1:nz)=ds_opt2_sc1(:,:,:)
    scr1(:,:,0)=scr1(:,:,1)   !this way I take care of the fact that Cs is defined in UVP in jz=1
    call int_var(scr1,scr2); call avg_var(scr2,ads,'ds',ii)                     !les stuff 
    call int_var(BETA_SC1,scr1); call avg_var(scr1,abetas,'betas',ii)
    call int_var(NU_SC1,scr1); call avg_var(scr1,anus,'nu_s',ii)
endif

!update record
if(mod(jt,p_cnt3).eq.0)then
   ii=ii+1
endif

if(s_flag.and.(jt==nsteps)) call deAllocScVar()


end subroutine ComputeBudget


!!------------------------------------------------------------------------------
!!  OBJECT: subroutine avg_var()
!!------------------------------------------------------------------------------
!!
!!  LAST CHECKED/MODIFIED: Marco Giometto ( mgiometto@gmail.com ), day 20/01/2014
!!
!!  DESCRIPTION:
!!
!!  This subroutine updates the value of the current variable
!!
!!------------------------------------------------------------------------------
subroutine avg_var(v,av,str_v,ii)


implicit none

real(rp),dimension(ld,ny,0:nz),intent(in) :: v
real,dimension(ld,ny,0:nz),intent(inout) :: av
character(*),intent(in) :: str_v
integer,intent(in) :: ii
character(128) :: fname
integer :: n

!counter
n=p_cnt3/c_cnt3

!average
av=av+real(v)/n

!save if index is reached
if(mod(jt,p_cnt3).eq.0)then
   write(fname,'(a,i0)') trim(ta1_field)//trim(str_v)//'.c',coord
   open(11,file=trim(fname),access='direct',recl=nx*ny*(nz-1))
   write(11,rec=ii) av(1:nx,1:ny,1:nz-1)
   close(11)
   av=0.0_rprec      !reinitialize averages
endif


end subroutine avg_var



!!------------------------------------------------------------------------------
!!  OBJECT: subroutine int_var()
!!------------------------------------------------------------------------------
!!
!!  LAST CHECKED/MODIFIED: Marco Giometto ( mgiometto@gmail.com ), day 20/01/2014
!!
!!  DESCRIPTION:
!!
!!  This subroutine interpolates from w to uvp
!!
!!------------------------------------------------------------------------------
subroutine int_var(v,iv)

implicit none

real(rp),dimension(ld,ny,0:nz),intent(in) :: v
real(rp),dimension(ld,ny,0:nz),intent(out) :: iv
integer :: k

!inteprolate
do k=0,nz-1
   iv(:,:,k)=0.5_rp*(v(:,:,k)+v(:,:,k+1))
enddo

end subroutine int_var







! SCALAR VARIABLES
subroutine allocScVar()

implicit none

allocate(as(ld,ny,0:nz))
allocate(aus(ld,ny,0:nz))
allocate(ass(ld,ny,0:nz))
allocate(avs(ld,ny,0:nz))
allocate(aws(ld,ny,0:nz))
allocate(atsx(ld,ny,0:nz))
allocate(atsy(ld,ny,0:nz))
allocate(atsz(ld,ny,0:nz))
allocate(adsdx(ld,ny,0:nz))
allocate(adsdy(ld,ny,0:nz))
allocate(adsdz(ld,ny,0:nz))
allocate(apdsdz(ld,ny,0:nz))
allocate(apsc1(ld,ny,0:nz))
allocate(asww(ld,ny,0:nz))
allocate(ads(ld,ny,0:nz))
allocate(abetas(ld,ny,0:nz))
allocate(anus(ld,ny,0:nz))
allocate(adsw(ld,ny,0:nz))

end subroutine allocScVar

