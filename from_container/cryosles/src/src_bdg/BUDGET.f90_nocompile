implicit none

DEallocate(as)
DEallocate(aus)
DEallocate(ass)
DEallocate(avs)
DEallocate(aws)
DEallocate(atsx)
DEallocate(atsy)
DEallocate(atsz)
DEallocate(adsdx)
DEallocate(adsdy)
DEallocate(adsdz)
DEallocate(apdsdz)
DEallocate(apsc1)
DEallocate(asww)
DEallocate(ads)
DEallocate(abetas)
DEallocate(anus)
DEallocate(adsw)

end subroutine deAllocScVar




end module budget
