MODULE SP_SC3

USE PARAM,ONLY:LD,NY,NZ,MODEL
USE TYPES

IMPLICIT NONE

REAL(RPREC),DIMENSION(LD,NY) :: LBC_SC3,        &          !DIRICHLET/FLUX BC
                                UBC_SC3

REAL(RPREC),DIMENSION(:,:,:),ALLOCATABLE :: EPSI_SC3


REAL(RPREC),DIMENSION(:,:,:),ALLOCATABLE ::  SC3,                          &
                                      RHS_SC3,RHSF_SC3,             &
                                      DSC3DZ,DSC3DX,DSC3DY,         &
                                      TXSC3,TYSC3,TZSC3,            &
                                      NU_SC3,BETA_SC3,SC3_LAG
REAL(RPREC),DIMENSION(:,:,:),ALLOCATABLE ::  DS_OPT2_SC3

!law of the wall models
REAL(RPREC),DIMENSION(LD,NY) :: DSC3DZMOD,TZSC3MOD

REAL(RPREC),DIMENSION(:,:),ALLOCATABLE :: SC3_STAR
REAL(RPREC),DIMENSION(:,:),ALLOCATABLE :: LBC_SC3_ZO

CONTAINS

! ALLOCATION
subroutine allocHumidity_particle()

print*,'allocation scalars'

ALLOCATE(EPSI_SC3(LD,NY,0:NZ))
ALLOCATE(SC3(LD,NY,0:NZ))
ALLOCATE(DSC3DX(LD,NY,0:NZ))
ALLOCATE(DSC3DY(LD,NY,0:NZ))
ALLOCATE(DSC3DZ(LD,NY,0:NZ))
ALLOCATE(RHS_SC3(LD,NY,0:NZ))
ALLOCATE(RHSF_SC3(LD,NY,0:NZ))
ALLOCATE(TXSC3(LD,NY,0:NZ))
ALLOCATE(TYSC3(LD,NY,0:NZ))
ALLOCATE(TZSC3(LD,NY,0:NZ))
ALLOCATE(NU_SC3(LD,NY,0:NZ))
ALLOCATE(BETA_SC3(LD,NY,0:NZ))
ALLOCATE(SC3_LAG(LD,NY,0:NZ))
ALLOCATE(DS_OPT2_SC3(LD,NY,NZ))
ALLOCATE(SC3_STAR(LD,NY))
ALLOCATE(LBC_SC3_ZO(LD,NY))

end subroutine allocHumidity_particle


! DEALLOCATION
subroutine deAllocHumidity_particle()

DEALLOCATE(EPSI_SC3)
DEALLOCATE(SC3)
DEALLOCATE(DSC3DX)
DEALLOCATE(DSC3DY)
DEALLOCATE(DSC3DZ)
DEALLOCATE(RHS_SC3)
DEALLOCATE(RHSF_SC3)
DEALLOCATE(TXSC3)
DEALLOCATE(TYSC3)
DEALLOCATE(TZSC3)
DEALLOCATE(NU_SC3)
DEALLOCATE(BETA_SC3)
DEALLOCATE(SC3_LAG)
DEALLOCATE(DS_OPT2_SC3)
DEALLOCATE(SC3_STAR)
DEALLOCATE(LBC_SC3_ZO)

end subroutine deAllocHumidity_particle



END MODULE SP_SC3
