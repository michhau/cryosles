MODULE SGS_FLUXES

USE PARAM
USE TYPES,ONLY:RPREC
USE SERVICE

!--------------------------------------------------------------------------------
CONTAINS   


!!-------------------------------------------------------------------------------
!!  OBJECT: SUBROUTINE SGS_FLUX ()
!!-------------------------------------------------------------------------------
!!
!!  LAST MODIFIED: Marco Giometto ( mgiometto@gmail.com ), day 16/05/2013
!!
!!  DESCRIPTION:
!!
!!
SUBROUTINE SGS_FLUX(THETA,DTDX,DTDY,DTDZ,CS,NU_T,NU_MLC,PR_SGS,DS,NU_S,TXTH,TYTH,TZTH)

IMPLICIT NONE

REAL(RPREC),DIMENSION(LD,NY,0:NZ),INTENT(IN) :: THETA,DTDX,DTDY,DTDZ,NU_T
REAL(RPREC),DIMENSION(LD,NY,NZ),  INTENT(IN) :: CS
REAL(RPREC),INTENT(IN) :: NU_MLC,PR_SGS
REAL(RPREC),DIMENSION(LD,NY,0:NZ),INTENT(OUT) :: NU_S
REAL(RPREC),DIMENSION(LD,NY,NZ),INTENT(OUT) :: DS
REAL(RPREC),DIMENSION(LD,NY,0:NZ),INTENT(OUT) :: TXTH,TYTH,TZTH
REAL(RPREC),DIMENSION(LD,NY) :: TOT_NU_U,TOT_NU_W
REAL(RPREC) :: KAT_XCORR,KAT_ZCORR 
INTEGER :: JZ


IF(VERBOSE) PRINT*,"STARTED SGS_FLUX"

!#################################################################
!CORRECTION FOR GRADIENT CASE KAT_FLOW @@@@@@@@@@(FIX NORMALIZATION!!)
IF(SLOPE)THEN 
   KAT_XCORR=N_SC1**2*DSIN(ALPHA*PI/180.0_RPREC)
   KAT_ZCORR=N_SC1**2*DCOS(ALPHA*PI/180.0_RPREC)
ELSE
   KAT_XCORR=0.0_RPREC
   KAT_ZCORR=0.0_RPREC
ENDIF


!#################################################################
!SGS COEFFICIENT
DS=CS/PR_SGS
NU_S=NU_T/PR_SGS


!#################################################################
!SGS STRESSESES

!JZ=1 SPECIAL TREATMENT (TZTH COMP. IN WALL_LAW ALTERNATIVELY)
TXTH(:,:,1) = (NU_MLC+NU_S(:,:,1))*(DTDX(:,:,1)-KAT_XCORR)        !UVP
TYTH(:,:,1) = (NU_MLC+NU_S(:,:,1))*DTDY(:,:,1)                    !UVP
IF(LLBC_SPECIAL.EQ.'STD')THEN
   TZTH(:,:,1)=(NU_MLC+NU_S(:,:,1))                    &
              * (0.5_RPREC*(DTDZ(:,:,2)+DTDZ(:,:,1))   &
              + KAT_ZCORR)                             !UVP (special)
ENDIF

!$OMP PARALLEL DO
DO JZ=2,NZ-1 
   TOT_NU_U(:,:)=0.5_RPREC*(NU_S(:,:,JZ)+NU_S(:,:,JZ+1))+NU_MLC   !UVP
   TXTH(:,:,JZ) = TOT_NU_U*(DTDX(:,:,JZ)-KAT_XCORR)               !UVP
   TYTH(:,:,JZ) = TOT_NU_U*DTDY(:,:,JZ)                           !UVP      
ENDDO
!$OMP END PARALLEL DO

!$OMP PARALLEL DO
DO JZ=2,NZ 
   TOT_NU_W(:,:) = NU_S(:,:,JZ)+NU_MLC                            !W
   TZTH(:,:,JZ) = TOT_NU_W*(DTDZ(:,:,JZ)+KAT_ZCORR)               !W
ENDDO
!$OMP END PARALLEL DO

!UNA TANTUM CHECK
IF(JT==5)THEN
      txTh(:,:,0)=BOGUS
      tyTh(:,:,0)=BOGUS
      tzTh(:,:,0)=BOGUS
      txTh(:,:,nz)=BOGUS
      tyTh(:,:,nz)=BOGUS
      !tzTh(:,:,nz)=BOGUS        !ATTENTION NOT TO PUT THIS = BOGUS
ENDIF


IF(VERBOSE) PRINT*,"FINISHED SGS_FLUX"

END SUBROUTINE SGS_FLUX

END MODULE SGS_FLUXES
