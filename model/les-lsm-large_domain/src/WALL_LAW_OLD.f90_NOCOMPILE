!               2.d0*(datan(y) - datan(y0))
! 
!          !C) Paulson's Stability function: ---------------------------
!       else
! 
!          !Paulson's Stability correction.
!                
!          x(i,j)=(1._rprec-15.2_rprec*dz/2._rprec/L(i,j))**.25_rprec
!          stab =2._rprec*dlog((1.+x(i,j))/2._rprec)+&
!               dlog((1._rprec+x(i,j)**2)/2._rprec)-2._rprec*datan(x(i,j))+pi/2._rprec
! 
!          psi_h(i,j)=2._rprec*dlog((1._rprec+x(i,j)**2)/2._rprec)
!          phi_m(i,j)=x(i,j)**(-1)
!          phi_h(i,j)=x(i,j)**(-2)
