! 
! use test_filtermodule
! implicit none
! 
! integer:: i,j,jz
! real(kind=rprec), dimension(nx,ny):: x,zeta,x0,zeta0 
! real(kind=rprec):: a,b,c,d,n,y,yy,xx,psi_zero,y0
! 
! real(kind=rprec) uf 
! real(kind=rprec) grav,stab !stab = psi_m
! REAL(RPREC), DIMENSION(LD,NY),INTENT(IN) :: SC_AVG
! 
! 
! ! Compute Obukhov Length
!     
! !
! L(i,j)=-uf**3/(vonk*(grav/SC_AVG(i,j))*SC1_STAR(i,j))
! wstar(i,j)=sign((grav/SC_AVG(i,j)*abs(SC1_STAR(i,j)))**(1./3.),SC1_STAR(i,j))
! 
! ! w_star is defined as [(g/<T_0>)*<w'T'>*z_i]**(1/3) (refer to Nieuwstadt et al., 
! ! Turbulent Shear flows, 1991). Since we are computing the non-dimensional value of w_star
! ! the formula transforms to [(g_nd/<T_0_nd>)*<w'T'>_nd]**(1/3) where the suffix
! ! _nd refers to being non-dimensionalized, using "u_star", "T_scale" and "z_i".
! 
! !Convective scenario. --------------------------------------------
! !-----------------------------------------------------------------
! if ((L(i,j)<0._rprec) .and. (SC1_STAR(i,j) .ne. 0._rprec)) then 
! 
!    !A) Brutsaert's Stability function: ---------------------------
!    
!    if (stab_function == 'brutsaert') then
!       a = 0.33d0
!       b = 0.41d0
!       c = 0.33d0
!       d = 0.057d0
!       n = 0.78d0
!       y = - (dz/2.d0)/L(i,j)
! 
!       if (y > b**(-3) ) then
!          
!          phi_m(i,j) = 1.d0
! 
!          yy =  (b**(-3.d0))
!          xx = (yy/a)**(1.d0/3.d0)
!          psi_zero = -dlog(a) + ((3.d0**(1.d0/2.d0))*b*(a**(1.d0/3.d0))*(pi/6.d0))
!          
!          stab = dlog(a+yy) - (3.d0*b*(yy**(1.d0/3.d0))) + &
!               (((b*(a**(1.d0/3.d0)))/2.d0)*dlog(((1+xx)**2)/(1 - xx + (xx**2)))) + &
!               ((3.d0**(1.d0/2.d0))*b*(a**(1.d0/3.d0)))*(datan(((2.d0*xx)-1)/(3.d0**(1.d0/2.d0)))) &
!               + psi_zero
! 
! 
!       else
! 
!          phi_m(i,j) = ( a + (b*(y**(4.d0/3.d0))) )/(a+y)
! 
!          xx = (y/a)**(1.d0/3.d0)
!          psi_zero = -dlog(a) + ((3.d0**(1.d0/2.d0))*b*(a**(1.d0/3.d0))*(pi/6.d0))
! 
!          stab = dlog(a+y) - (3.d0*b*(y**(1.d0/3.d0))) + &
!               (((b*(a**(1.d0/3.d0)))/2.d0)*dlog(((1+xx)**2)/(1 - xx + (xx**2)))) + &
!               ((3.d0**(1.d0/2.d0))*b*(a**(1.d0/3.d0)))*(datan(((2.d0*xx)-1)/(3.d0**(1.d0/2.d0)))) &
!               + psi_zero
! 
!       end if
!             
!       phi_h(i,j) = (c + (d*(y**n)))/(c+(y**n))
!       psi_h(i,j) = ((1-d)/n)*dlog((c+(y**n))/c)
! 
!       !B) Benoit's Stability function: ----------------------------
!    else 
!       if (stab_function == 'benoit') then
! 
!          !Benoit's Stability correction. (Benoit 1977, Journal of applied meteorology)
!          
!          y =(1._rprec - 15._rprec*((dz/2._rprec)/L(i,j)) )**.25_rprec
!          y0 =(1._rprec - 15._rprec*((LBC_ZO(i,j))/L(i,j)) )**.25_rprec
