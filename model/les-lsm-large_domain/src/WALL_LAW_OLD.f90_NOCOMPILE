!       ! The equations: phi_h(X) = 1+c*[(X+(X^d)*{(1+X^d)^(-1+1/d)})/(X+{(1+X^d)^(1/d)})];c=5.3;d=1.1
!       ! The equations: psi_m(X) = -a*ln[X+{(1+X^b)^(1/b)}];a=6.1;b=2.5
!       ! The equctions: psi_h(X) = -c*ln[X+{(1+X^d)^(1/d)}];c=5.3;d=1.1
!       ! %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
!       phi_m(i,j)=1._rprec+6.1_rprec*(zeta(i,j)+zeta(i,j)**2.5_rprec*&
!            ((1._rprec+zeta(i,j)**2.5_rprec)**(-1._rprec+1._rprec/2.5_rprec)))/(zeta(i,j)+&
!            ((1._rprec+zeta(i,j)**2.5_rprec)**(1._rprec/2.5_rprec)))
!       
!       stab =-1._rprec*6.1_rprec*dlog(zeta(i,j)+((1._rprec+&
!            zeta(i,j)**2.5_rprec)**(1._rprec/2.5_rprec)))
!       
!       psi_m0(i,j)=-1._rprec*6.1_rprec*dlog(zeta0(i,j)+((1._rprec+& !MCB, at the surface, with z0 height.
!            zeta0(i,j)**2.5_rprec)**(1._rprec/2.5_rprec)))
!       
!       phi_h(i,j)=1._rprec+5.3_rprec*(zeta(i,j)+zeta(i,j)**1.1_rprec*&
!            ((1._rprec+zeta(i,j)**1.1_rprec)**(-1._rprec+1._rprec/1.1_rprec)))/(zeta(i,j)+&
!            ((1._rprec+zeta(i,j)**1.1_rprec)**(1._rprec/1.1_rprec)))
!       
!       psi_h(i,j)=-1._rprec*5.3_rprec*dlog(zeta(i,j)+((1._rprec+&
!            zeta(i,j)**1.1_rprec)**(1._rprec/1.1_rprec)))
!       
!       ! %%%%%%%%%%%%%%%%%%%%%%%% Formulations used in Brutsaert (1982) %%%%%%%%%%%%%%%%%%%%
!       !             phi_m(jx,jy)=1._rprec+5.0_rprec*zeta(jx,jy)
!       !             phi_h(jx,jy)=1._rprec+5.0_rprec*zeta(jx,jy)
