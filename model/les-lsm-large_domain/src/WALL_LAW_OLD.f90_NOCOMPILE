! 
! else 
!    !Stable scenario. ------------------------------------------------
!    !-----------------------------------------------------------------
!          
!    if ((L(i,j)>0._rprec).and.(SC1_STAR(i,j).ne. 0._rprec)) then
! 
!       ! Implementing new formulations for phi and psi for stable case
