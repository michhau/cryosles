!       !             psi_h(jx,jy)=-1._rprec*5.0_rprec*zeta(jx,jy)
!       !end if ! end for the jan_diurnal_run if block     
!    else
! 
!       !Neutral scenario. -----------------------------------------------
!       !-----------------------------------------------------------------
!       stab=0._rprec
!       psi_m0(i,j)=0._rprec !MCB, at the surface, with z0 height.
!       
!       psi_h(i,j)=0._rprec
!       phi_m(i,j)=1._rprec
!       phi_h(i,j)=0.6d0
!    end if ! (Loop5 ends)
! end if
! 
! end subroutine PSI_compute

